# ==============================================================================
# 🔐 SÉCURITÉ & SECRETS (LE PLUS IMPORTANT)
# ==============================================================================
.env
.env.*
!.env.sample
*.pem
*.key
# *.json est ignoré volontairement : les clés de service account GCP portent des
# noms imprévisibles (mon-projet-1234567-abcdef.json) et une fuite coûte cher.
# Pour versionner un JSON légitime, ajoute une exception ciblée :
#   !config/settings.json
*.json

# ==============================================================================
# 🐍 ENVIRONNEMENT PYTHON
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Caches d'outils (ruff, mypy, pytest, notebooks)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ==============================================================================
# 📦 ENVIRONNEMENTS VIRTUELS
# ==============================================================================
venv/
.venv/
env/
.env_python/
pip-log.txt
pip-delete-this-directory.txt

# État local de direnv (le projet versionne .envrc, pas son cache)
.direnv/

# ==============================================================================
# 📊 DATA & MACHINE LEARNING (Ne pas polluer Git avec des gros fichiers)
# ==============================================================================
raw_data/
data/
training_outputs/
*.csv
*.parquet
*.npz
*.h5
*.pkl
*.model
# Artefacts locaux créés par MLflow ou Prefect.
# MLflow 2 utilisait un simple dossier (mlruns/) ; MLflow 3 crée par défaut une
# base SQLite (mlflow.db) — avec ses fichiers WAL/SHM associés.
mlruns/
mlflow.db
mlflow.db-*
.prefect/

# ==============================================================================
# 💻 SYSTÈME (Fichiers invisibles de ton OS)
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.Identifier

# Configuration locale de l'outillage (jamais partagée)
.claude/settings.local.json
