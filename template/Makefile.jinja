# Load the .env file
-include .env

# Export the variables so they are available to the shell
export

{% if with_gcp %}# Build the Service Account email dynamically
SA_EMAIL = $(SA_NAME)@$(GCP_PROJECT).iam.gserviceaccount.com

{% endif %}include make/*.mk

# --- Automatic help menu ---
.DEFAULT_GOAL := help

help: ## Show this help menu
	@awk 'BEGIN {FS = ":.*##"; printf "\nUsage:\n  make \033[36m<target>\033[0m\n\nAvailable targets:\n"} /^[a-zA-Z_-]+:.*?##/ { printf "  \033[36m%-30s\033[0m %s\n", $$1, $$2 }' $(MAKEFILE_LIST)

# ==============================================================================
# 🧹 PROJECT CLEANING & SETUP
# ==============================================================================

reinstall_package: ## Force a clean reinstall of the environment (bypasses uv cache)
	@echo "🔄 Reinstalling environment..."
	@uv sync --reinstall
	@echo "✅ Environment reinstalled successfully."

init_data_folders: ## Create the local data and model registry directories
	@echo "📁 Creating local folders..."
	@mkdir -p data/raw
	@mkdir -p data/processed
	@mkdir -p models/models
	@mkdir -p models/params
	@mkdir -p models/metrics
	@echo "✅ Folders created. Their contents are git-ignored (data/, *.pkl, *.json)."

clean: ## Clean Python cache, build files, and hidden OS files
	@echo "🧹 Cleaning up project..."
	@find . -type d -name "__pycache__" -exec rm -rf {} +
	@find . -type d -name ".ipynb_checkpoints" -exec rm -rf {} +
	@find . -type f -name "*.pyc" -delete
	@find . -type f -name ".coverage" -delete
	@find . -type f -name "*Zone.Identifier" -delete
	@find . -type f -name ".DS_Store" -delete
	@rm -rf build/ dist/ *.egg-info/ *.dist-info/
	@rm -rf .pytest_cache/ .ruff_cache/ .mypy_cache/ .coverage
	@echo "✅ Cleaned up successfully."

# ==============================================================================
# DYNAMIC SAFETY MACROS
# ==============================================================================
# Called by the targets in `make/*.mk`, and defined here because this file is
# the only makefile the project loads before them.

# Macro 1: Assert required variables are non-empty (Fail-fast validation)
# Nothing is sent to a cloud command until the variables it reads are filled:
# an empty value does not fail, it silently means something else (the account
# of the active project, a resource with no name), and the mistake surfaces
# much later, far from its cause.
define check_vars
	$(foreach var,$(1),$(if $(value $(var)),,$(error ❌ ERROR: Variable $(var) is required but unset — set it in your .env)))
endef

# Macro 2: Print target variables and prompt for operator confirmation
define confirm_action
	@echo "\n======================================================="
	@echo " ⚠️  TARGET ACTION: $(1)"
	@echo "======================================================="
	@$(foreach var,$(2),echo " 🔹 $(var) : \033[33m$($(var))\033[0m";)
	@echo "======================================================="
	@read -p "Confirm execution? [y/N] " ans; \
	if [ "$$ans" != "y" ] && [ "$$ans" != "Y" ]; then echo "\n❌ Operation cancelled by user." >&2; exit 1; fi
	@echo "✅ Operation confirmed.\n"
endef

# Macro 3: Refuse to run when the working tree holds uncommitted work
# For the targets that REWRITE files (`ruff --fix`, `ruff format`): their edits
# would otherwise mix with work in progress, and the diff would no longer tell
# the two apart. Both halves matter - the first covers unstaged edits, the
# second what has been staged but not committed.
# A project Copier has just generated is not a git repository yet (it ships a
# .gitignore and a .gitattributes, and its owner runs `git init` when they
# want one): there is nothing to mix with, so the check steps aside instead of
# refusing a target that could not do any harm.
define require_clean_tree
	@if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then \
		git diff --quiet -- . && git diff --cached --quiet -- . || { \
			echo "❌ Uncommitted changes - commit or stash them first, or ruff will rewrite files you are still working on." >&2; \
			exit 1; \
		}; \
	fi
endef
