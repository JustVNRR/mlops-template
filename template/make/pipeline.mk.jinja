# ==============================================================================
# ML PIPELINE COMMANDS
# ==============================================================================

run_preprocess: ## Run the preprocessing step
	uv run python -c 'from {{ package_name }}.interface.main import preprocess; preprocess()'

run_train: ## Run the training step
	uv run python -c 'from {{ package_name }}.interface.main import train; train()'

run_evaluate: ## Run the evaluation step
	uv run python -c 'from {{ package_name }}.interface.main import evaluate; evaluate()'

run_pred: ## Run the prediction step
	uv run python -c 'from {{ package_name }}.interface.main import pred; pred()'

run_all: run_preprocess run_train run_evaluate run_pred ## Run the full pipeline (preprocess train evaluate pred)

run_api: ## Run the FastAPI application locally with hot-reloading
	@echo "🚀 Starting FastAPI locally..."
	uv run uvicorn {{ package_name }}.api.fast:app --host 0.0.0.0 --port 8000 --reload
{% if with_prefect %}
run_workflow: ## Run the Prefect orchestration workflow
	PREFECT__LOGGING__LEVEL=$(PREFECT_LOG_LEVEL) uv run python -m {{ package_name }}.interface.workflow
{% endif %}
