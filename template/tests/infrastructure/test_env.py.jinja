import os
from pathlib import Path

import pytest
from dotenv import load_dotenv

# The .env lives at the PROJECT ROOT, not in the current directory: a test run
# from a subdirectory must still find it.
PROJECT_ROOT = Path(__file__).resolve().parent.parent.parent
ENV_PATH = PROJECT_ROOT / ".env"


def test_env_file_exists():
    """Verify that the .env file exists at the root of the project."""
    assert ENV_PATH.is_file(), f"❌ {ENV_PATH} is missing! Run this first: cp .env.sample .env"


@pytest.mark.integration
def test_critical_env_variables_are_set():
    """
    Verify that critical variables are filled and not left empty.

    Marked `integration`: this test requires a FULLY configured project, so it
    fails on a development machine for a perfectly legitimate reason. It must
    therefore neither block the default run nor fail the CI.

    → Run it with `make test_integration` once your .env is filled in.
    """
    load_dotenv(ENV_PATH)

    # Add here any variable your project absolutely requires.
    critical_vars = [{% if 'gcp' in modules %}"GCP_PROJECT", "GCP_REGION", "BUCKET_NAME"{% endif %}]

    for var in critical_vars:
        value = os.getenv(var)
        assert value, f"❌ '{var}' is empty in your .env file: fill it in."
