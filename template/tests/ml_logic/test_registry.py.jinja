# Targets that this project cannot serve: the building block providing them was
# left out at generation time.
UNIMPLEMENTED_TARGETS = [{% if with_gcp %}"gcs", {% endif %}{% if with_mlflow %}"mlflow"{% endif %}]


def test_save_model_raises_on_unimplemented_target(local_registry, monkeypatch):
    """An unimplemented target must fail loudly, not silently."""
    for target in UNIMPLEMENTED_TARGETS:
        monkeypatch.setattr(registry, "MODEL_TARGET", target)

        with pytest.raises(NotImplementedError, match=target):
            registry.save_model(object())


def test_save_model_writes_nothing_on_unimplemented_target(local_registry, monkeypatch):
    """
    The target is validated BEFORE writing: otherwise a model would be left on
    disk while an exception is raised (a partial success).
    """
    for target in UNIMPLEMENTED_TARGETS:
        monkeypatch.setattr(registry, "MODEL_TARGET", target)

        with pytest.raises(NotImplementedError):
            registry.save_model(object())

        assert not (local_registry / "models").exists()
