{% if 'gcp' in modules %}# ==============================================================================
# ⚙️ GLOBAL GCP CONFIGURATION
# ==============================================================================
# Example: GCP_PROJECT=my-gcp-project-id
GCP_PROJECT=
# Example: GCP_REGION=europe-west1
GCP_REGION=

# Path to your GCP Service Account JSON key (mandatory for local/tests)
# Example: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/gcp-key.json
# GOOGLE_APPLICATION_CREDENTIALS=

# ==============================================================================
# 🖥️ COMPUTE ENGINE (VM) & IAM
# ==============================================================================
# Example: ZONE=europe-west1-b
ZONE=
# Example: INSTANCE=my-vm-instance
INSTANCE=
# Example: MACHINE_TYPE=e2-standard-2
MACHINE_TYPE=
# Example: IMAGE_FAMILY=ubuntu-2204-lts
IMAGE_FAMILY=
# Example: IMAGE_PROJECT=ubuntu-os-cloud
IMAGE_PROJECT=
# Example: SA_NAME=my-project-vm-sa
SA_NAME=

# ==============================================================================
# 🗄️ STORAGE & BIGQUERY
# ==============================================================================
# Note: Bucket names must be globally unique across all of Google Cloud!
# Example: BUCKET_NAME=my-unique-bucket-name-12345
BUCKET_NAME=
# Example: BQ_REGION=EU
BQ_REGION=
# Example: BQ_DATASET=my_project_dataset
BQ_DATASET=

{% endif %}# ==============================================================================
# 🐍 PYTHON ENVIRONMENT
# ==============================================================================
# Nothing to configure here: the Python version is pinned in the
# `.python-version` file at the project root, and uv uses it to install the
# right interpreter{% if 'gcp' in modules %} — locally as well as on the GCP VM
# (`make local_setup`){% endif %}.
# To change it: `uv python pin 3.13`.

{% if 'gcp' in modules or 'docker' in modules %}# ==============================================================================
# 🐳 CONTAINER IMAGE
# ==============================================================================
# The image name, used both to build locally and to deploy.
# Example: GAR_IMAGE=my-api-image
GAR_IMAGE=
{% if 'docker' in modules %}# Example: DOCKER_BASE_IMAGE=python:3.10.6-slim
DOCKER_BASE_IMAGE=
{% endif %}{% endif %}{% if 'gcp' in modules %}
# ==============================================================================
# ☁️ ARTIFACT REGISTRY & CLOUD RUN
# ==============================================================================
# Example: ARTIFACTSREPO=my-artifacts-repo
ARTIFACTSREPO=
# Example: GAR_MEMORY=2Gi
GAR_MEMORY=


# SERVICE_URL is populated after Cloud Run deployment (used for Cloud API tests)
# Example: SERVICE_URL=https://my-api-image-123456789-ew.a.run.app
# SERVICE_URL=
{% endif %}

# ==============================================================================
# 📊 DATA & PIPELINE CONFIGURATION
# ==============================================================================
# Where the raw data comes from (options: demo{% if 'gcp' in modules %}, bigquery{% endif %}).
# If left empty, 'demo' is used: a synthetic dataset generated in memory, so the
# whole pipeline runs with no cloud account and no data file to version.
{% if 'gcp' in modules %}# Example: DATA_SOURCE=bigquery
{% endif %}DATA_SOURCE=
# Example: DATA_SIZE=1k
DATA_SIZE=
# Example: CHUNK_SIZE=100000
CHUNK_SIZE=
# Where trained models are stored (options: local{% if 'gcp' in modules %}, gcs{% endif %}{% if 'mlflow' in modules %}, mlflow{% endif %}).
# If left empty, 'local' is used: no cloud account required.
{% if 'mlflow' in modules %}# Example: MODEL_TARGET=mlflow
{% endif %}MODEL_TARGET=

# ==============================================================================
# 🔬 MLFLOW CONFIGURATION
# ==============================================================================
# Example: MLFLOW_TRACKING_URI=https://mlflow.my-domain.com
MLFLOW_TRACKING_URI=
# Example: MLFLOW_EXPERIMENT=my_experiment
MLFLOW_EXPERIMENT=
# Example: MLFLOW_MODEL_NAME=my_model
MLFLOW_MODEL_NAME=

# ==============================================================================
# ⏱️ PREFECT & SCHEDULING
# ==============================================================================
# Example: PREFECT_FLOW_NAME=my_main_flow
PREFECT_FLOW_NAME=
# Example: PREFECT_LOG_LEVEL=INFO
PREFECT_LOG_LEVEL=
# Example: EVALUATION_START_DATE=2024-01-01
EVALUATION_START_DATE=

# ==============================================================================
# 🪵 LOGGING
# ==============================================================================
# Verbosity of the application logs (options: TRACE, DEBUG, INFO, SUCCESS,
# WARNING, ERROR, CRITICAL).
# If left empty, 'INFO' is used: pipeline milestones. DEBUG adds the per-file
# chatter (every JSON written, every autolog line).
# Example: LOG_LEVEL=DEBUG
LOG_LEVEL=

# ==============================================================================
# 🔔 NOTIFICATIONS (WEBHOOKS)
# ==============================================================================
# Example: NOTIFY_BASE_URL=https://hooks.slack.com/services/...
NOTIFY_BASE_URL=
# Example: NOTIFY_CHANNEL=#alerts
NOTIFY_CHANNEL=
# Example: NOTIFY_AUTHOR=Data_Pipeline_Bot
NOTIFY_AUTHOR=
