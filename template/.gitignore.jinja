# ==============================================================================
# 🔐 SECURITY & SECRETS (THE MOST IMPORTANT PART)
# ==============================================================================
.env
.env.*
# `.env.sample*` and not `.env.sample`: Copier filters the template through
# .gitignore, and the source file is named `.env.sample.jinja`. Without the
# wildcard it is skipped, and the generated project silently ships without it.
!.env.sample*
*.pem
*.key
# *.json is ignored on purpose: service-account keys and other credentials have
# unpredictable names (my-project-1234567-abcdef.json) and a leak is expensive.
# To version a legitimate JSON file, add a targeted exception:
#   !config/settings.json
*.json

# ==============================================================================
# 🐍 PYTHON ENVIRONMENT
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Tooling caches (ruff, mypy, pytest, notebooks)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ==============================================================================
# 📦 VIRTUAL ENVIRONMENTS
# ==============================================================================
venv/
.venv/
env/
.env_python/
pip-log.txt
pip-delete-this-directory.txt

# Local direnv state (the project versions .envrc, not its cache)
.direnv/

# ==============================================================================
# 📊 DATA & MACHINE LEARNING (keep large files out of git)
# ==============================================================================
raw_data/
data/
training_outputs/
*.csv
*.parquet
*.npz
*.h5
*.pkl
*.model
{% if 'mlflow' in modules %}# Local artefacts created by MLflow.
# MLflow 2 used a plain directory (mlruns/); MLflow 3 creates a SQLite database
# by default (mlflow.db), along with its WAL/SHM companion files.
mlruns/
mlflow.db
mlflow.db-*
{% endif %}.prefect/

# ==============================================================================
# 🪵 LOGS (runtime output, never versioned)
# ==============================================================================
# Log files accumulate indefinitely and carry more than you expect: request
# paths, row counts, and occasionally a credential pasted into a message. They
# are output, not source.
logs/
*.log

# ==============================================================================
# 💻 SYSTEM (invisible files from your OS)
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.Identifier

# Local tooling configuration (never shared)
.claude/settings.local.json
