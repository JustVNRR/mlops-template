{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 1) Data Exploration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from {{ package_name }}.ml_logic.data import clean_data, get_raw_data\n",
    "from {{ package_name }}.ml_logic.model import build_model, evaluate_model, train_model\n",
    "from {{ package_name }}.ml_logic.preprocessor import build_preprocessor\n",
    "from {{ package_name }}.params import (\n",
    "    ALL_FEATURES,\n",
    "    CATEGORICAL_FEATURES,\n",
    "    DTYPES_RAW,\n",
    "    NUMERIC_FEATURES,\n",
    "    TARGET_COLUMN,\n",
    ")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1.1) Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# `get_raw_data()` dispatches on DATA_SOURCE. Out of the box it returns the\n",
    "# demonstration dataset, so this notebook runs with no account and no data file.\n",
{% if with_gcp %}    "# Set DATA_SOURCE=bigquery in .env to read from your own table instead.\n",
{% endif %}    "raw = get_raw_data()\n",
    "raw.shape"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.1.1) Compress Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# The dtypes declared in params.DTYPES_RAW are what keep the frame small:\n",
    "# float32 halves the footprint of a float64, int8 is plenty for small counts.\n",
    "# `clean_data()` applies them — here is what they buy, measured.\n",
    "narrowed = raw.astype({column: dtype for column, dtype in DTYPES_RAW.items() if column in raw.columns})\n",
    "\n",
    "print(f\"raw      {raw.memory_usage(deep=True).sum() / 1e6:.2f} MB\")\n",
    "print(f\"narrowed {narrowed.memory_usage(deep=True).sum() / 1e6:.2f} MB\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1.2) Clean Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Dtypes, exact duplicates, rows missing a schema column, and the placeholder\n",
    "# outlier rule. `ml_logic/data.py` is where your own cleaning rules belong.\n",
    "clean = clean_data(raw)\n",
    "clean.shape"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1.3) Visualize Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# No plotting library ships with the template, so `describe()` stands in for\n",
    "# charts. Add them with `uv add --dev matplotlib` and swap these lines out.\n",
    "display(clean[NUMERIC_FEATURES].describe())\n",
    "display(clean[TARGET_COLUMN].describe())\n",
    "display(clean[CATEGORICAL_FEATURES[0]].value_counts())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1.4) Baseline Score  - Preliminary Intuitions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# The number every model has to beat: always predicting the mean. Without it,\n",
    "# an MAE is a value with no scale to judge it by.\n",
    "baseline_mae = (clean[TARGET_COLUMN] - clean[TARGET_COLUMN].mean()).abs().mean()\n",
    "baseline_mae"
   ]
  },
  {
   "attachments": {},
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 2) Train/Val/Test Split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# The same split as `train()` in interface/main.py, so this notebook and the\n",
    "# pipeline agree. On a time series, split chronologically instead: shuffling\n",
    "# would mean training on the future to predict the past.\n",
    "split_ratio = 0.2\n",
    "\n",
    "train_df = clean.sample(frac=1 - split_ratio, random_state=42)\n",
    "val_df = clean.drop(train_df.index)\n",
    "\n",
    "X_train, y_train = train_df[ALL_FEATURES], train_df[TARGET_COLUMN]\n",
    "X_val, y_val = val_df[ALL_FEATURES], val_df[TARGET_COLUMN]\n",
    "\n",
    "len(X_train), len(X_val)"
   ]
  },
  {
   "attachments": {},
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 3) Preprocessing Pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fitted on the TRAINING split only: fitting on everything would leak the\n",
    "# validation distribution into training and flatter the metrics.\n",
    "preprocessor = build_preprocessor()\n",
    "preprocessor.fit(X_train)\n",
    "\n",
    "preprocessor.transform(X_train).shape"
   ]
  },
  {
   "attachments": {},
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 4) Model"
   ]
  },
  {
   "attachments": {},
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4.1) Architecture"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# `build_model()` returns a complete Pipeline: the preprocessor is a step of the\n",
    "# estimator, so `model.predict()` accepts a raw DataFrame. The API depends on\n",
    "# exactly that — it never calls the preprocessor itself.\n",
    "model = build_model(alpha=1.0)\n",
    "model"
   ]
  },
  {
   "attachments": {},
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4.2) Performance evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "model, _ = train_model(model, X_train, y_train)\n",
    "metrics = evaluate_model(model, X_val, y_val)\n",
    "\n",
    "print(f\"baseline MAE (predict the mean): {baseline_mae:.3f}\")\n",
    "print(f\"model MAE:                       {metrics['mae']:.3f}\")\n",
    "\n",
    "metrics"
   ]
  }
 ],
