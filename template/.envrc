dotenv

# Activate the project environment while you are here, so the prompt shows
# which Python your commands target; direnv undoes it when you leave. The guard
# keeps this silent before the first `uv sync`, when there is nothing to
# activate yet. Without direnv none of this runs, and `uv run` / `make` still
# find the environment on their own.
[ -f .venv/bin/activate ] && source .venv/bin/activate
