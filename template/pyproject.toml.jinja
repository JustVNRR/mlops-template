[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ package_name }}"
version = "0.0.1"
description = "{{ project_name }}"
readme = "README.md"
requires-python = ">=3.11"

authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
license = { text = "{{ license }}" }

# PRODUCTION dependencies: everything needed to serve the API.
# Versions are locked by uv.lock (generated, committed) — that file is what
# guarantees reproducibility, not these lower bounds.
dependencies = [
  # --- API / serving ---
  "fastapi>=0.115",
  "uvicorn[standard]>=0.30",
  "pydantic>=2.7",

  # --- Data handling ---
  "pandas>=2.2",
  "numpy>=1.26",
  "scikit-learn>=1.5",
{% if 'gcp' in modules %}  # Required for the pandas <-> BigQuery interop (load_table_from_dataframe
  # and result.to_dataframe). Without them, the BQ calls fail at runtime.
  "pyarrow>=16.0",
  "db-dtypes>=1.2",

  # --- Google Cloud ---
  "google-cloud-bigquery>=3.25",
  "google-cloud-storage>=2.17",
{% endif %}

  # --- Model lifecycle ---
{% if 'mlflow' in modules %}  "mlflow>=2.14",
{% endif %}  "prefect>=2.19",

  # --- Utilities ---
  "python-dotenv>=1.0",
  "loguru>=0.7",       # logging: replaces both print() and colorama
  "pygeohash>=1.2",
  "requests>=2.32",
  "python-dateutil>=2.9",
]

# DEVELOPMENT dependencies (PEP 735).
# `uv sync` installs them by default; `uv sync --no-dev` excludes them
# (production / Docker).
[dependency-groups]
dev = [
  "pytest>=8.2",
  "pytest-asyncio>=0.23",
  "httpx>=0.27",       # HTTP client used by the API tests
  "ruff>=0.6",         # lint + format
  "ipykernel>=6.29",   # running the notebooks
]

# ==============================================================================
# 📦 PACKAGING
# ==============================================================================
# src layout: the importable package lives under src/, while tests/, notebooks/
# and the configuration stay at the root. This separation is deliberate — the
# package cannot be imported by accident from the working directory, so tests
# exercise the INSTALLED package, the same one production uses.
#
# The package name is a template answer, so it is declared explicitly rather
# than discovered automatically.
[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

# ==============================================================================
# 🔍 RUFF — lint + format
# ==============================================================================
[tool.ruff]
line-length = 120
target-version = "py311"
exclude = [".venv", "build", "dist", "notebooks"]

[tool.ruff.lint]
select = [
  "E4", "E7", "E9",  # pycodestyle errors
  "F",               # pyflakes: unused imports, undefined names
  "W",               # pycodestyle warnings
  "I",               # import sorting (isort)
  "UP",              # syntax modernisation (pyupgrade)
  "B",               # common pitfalls (flake8-bugbear)
]
ignore = [
  "E501",  # line length: handled by the formatter, not the linter
]

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]

[tool.ruff.format]
quote-style = "double"

# ==============================================================================
# 🧪 PYTEST
# ==============================================================================
# ⚠️ This config lives HERE and not in tests/pytest.ini: pytest only looks for a
# pytest.ini in the PARENT directories of its arguments, never in a
# subdirectory. A tests/pytest.ini was therefore silently ignored (no -v, no
# warning filters, no markers).
[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-v -ra -s --tb=short -W ignore::DeprecationWarning -m 'not integration'"
asyncio_mode = "auto"
markers = [
  "integration: requires a real external service (GCP, Docker container, deployed API). Excluded by default; run with `-m integration`.",
]
