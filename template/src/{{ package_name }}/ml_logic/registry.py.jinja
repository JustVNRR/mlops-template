# ==============================================================================
# 🗂️ LOCAL REGISTRY LAYOUT
# ==============================================================================
#   models/                  <- LOCAL_REGISTRY_PATH
#   ├── models/              <- model weights,  timestamped <timestamp>.pkl
#   ├── params/              <- hyperparameters, <timestamp>.json
#   └── metrics/             <- metrics,         <timestamp>.json
#
# The directories are created on first save: nothing to do by hand, and the
# pipeline works on a fresh clone.
MODELS_DIR = LOCAL_REGISTRY_PATH / "models"
PARAMS_DIR = LOCAL_REGISTRY_PATH / "params"
METRICS_DIR = LOCAL_REGISTRY_PATH / "metrics"

# MLflow alias pointing at the model served in production (see below).
DEFAULT_ALIAS = "champion"


# ==============================================================================
# 🛠️ HELPERS
# ==============================================================================
def _to_jsonable(obj: Any) -> Any:
    """
    Recursively convert numpy (and Path) values into native Python types.

    Essential: a `metrics` dict produced by scikit-learn holds `np.float64`
    values, which `json.dump` rejects with a terse
    "Object of type float64 is not JSON serializable".
    """
    if isinstance(obj, dict):
        return {str(k): _to_jsonable(v) for k, v in obj.items()}
    if isinstance(obj, (list, tuple, set)):
        return [_to_jsonable(v) for v in obj]
    if isinstance(obj, np.generic):
        return obj.item()  # np.float64 -> float, np.int64 -> int
    if isinstance(obj, np.ndarray):
        return obj.tolist()
    if isinstance(obj, Path):
        return str(obj)
    return obj


def _write_json(path: Path, payload: dict) -> None:
    """Write a human-readable (indented) JSON file, creating directories as needed."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w", encoding="utf-8") as file:
        json.dump(_to_jsonable(payload), file, indent=2, ensure_ascii=False)
    logger.debug(f"Saved: {path}")


def _latest_file(directory: Path, pattern: str = "*") -> Path | None:
    """
    Return the most RECENTLY MODIFIED file matching `pattern`.

    Sorting is by modification time, never by name: alphabetical order would
    pick 'zzz.pkl' over the latest training run, and turns silently wrong as
    soon as a file does not follow the <timestamp>.pkl convention — a
    `best_model.pkl`, for instance.
    """
    if not directory.is_dir():
        return None

    files = [path for path in directory.glob(pattern) if path.is_file()]
    if not files:
        return None

    return max(files, key=lambda path: path.stat().st_mtime)


# ==============================================================================
# 💾 SAVING
# ==============================================================================
def save_results(params: dict | None = None, metrics: dict | None = None) -> None:
    """
    Persist params & metrics locally on the hard drive.
    If MODEL_TARGET='mlflow', also persist them on MLflow.
    """
    timestamp = time.strftime("%Y%m%d-%H%M%S")

    # 1. Local JSON save. JSON is readable, diffs in git, and loads back from
    #    any Python version — three things pickle does not offer.
    if params is not None:
        _write_json(PARAMS_DIR / f"{timestamp}.json", params)

    if metrics is not None:
        _write_json(METRICS_DIR / f"{timestamp}.json", metrics)

    logger.info(f"Results saved locally ({LOCAL_REGISTRY_PATH})")

    # 2. MLflow save.
    #    Reminder: log_params/log_metrics only make sense INSIDE an active run,
    #    which the @mlflow_run decorator on train()/evaluate() takes care of.
    if MODEL_TARGET == "mlflow":
        if params is not None:
            mlflow.log_params(params)
        if metrics is not None:
            mlflow.log_metrics(metrics)
        logger.info("Results saved on MLflow")


def save_model(model: Any) -> None:
    """
    Persist trained model locally on the hard drive.
    - if MODEL_TARGET='gcs', also persist it in the GCS bucket
    - if MODEL_TARGET='mlflow', also persist it on MLflow
    """
    # The target is validated BEFORE anything is written: otherwise a model
    # would be left on disk while an exception is raised, producing a partial
    # success that is very hard to diagnose.
    if MODEL_TARGET == "gcs":
        raise NotImplementedError(
            "❌ MODEL_TARGET='gcs': uploading to Cloud Storage is not implemented.\n"
            "   → Implement it here (google.cloud.storage), or set MODEL_TARGET=local in your .env."
        )

    if MODEL_TARGET == "mlflow":
        raise NotImplementedError(
            "❌ MODEL_TARGET='mlflow': logging the model is not implemented.\n"
            "   → Uncomment the mlflow.<framework>.log_model block below, or set MODEL_TARGET=local in your .env."
        )

    # --- MODEL_TARGET == "local" ---
    timestamp = time.strftime("%Y%m%d-%H%M%S")
    model_path = MODELS_DIR / f"{timestamp}.pkl"

    # TODO: adapt serialisation to your framework (Keras .keras, PyTorch .pt,
    # XGBoost .json…) — pickle suits scikit-learn.
    model_path.parent.mkdir(parents=True, exist_ok=True)
    with open(model_path, "wb") as file:
        pickle.dump(model, file)

    logger.info(f"Model saved locally: {model_path}")

    # TODO (MODEL_TARGET='mlflow' — uncomment in the dedicated branch):
    # mlflow.sklearn.log_model(
    #     sk_model=model,
    #     artifact_path="model",
    #     registered_model_name=MLFLOW_MODEL_NAME,
    # )


# ==============================================================================
# 📥 LOADING
# ==============================================================================
def load_model(stage: str = DEFAULT_ALIAS) -> Any | None:
    """
    Return a saved model:
    - locally the most recent one (by modification time)
    - or from GCS (most recent one) if MODEL_TARGET == 'gcs'
    - or from MLflow, by alias, if MODEL_TARGET == 'mlflow'

    `stage` is a legacy parameter name: it designates the MLflow ALIAS (see
    mlflow_set_alias).
    """
    if MODEL_TARGET == "local":
        logger.info("Load latest model from local registry...")

        model_path = _latest_file(MODELS_DIR, pattern="*.pkl")
        if model_path is None:
            logger.warning(f"No model found in {MODELS_DIR} - train one first: `make run_train`")
            return None

        logger.info(f"Loading model: {model_path.name}")
        with open(model_path, "rb") as file:
            return pickle.load(file)

    if MODEL_TARGET == "gcs":
        raise NotImplementedError(
            "❌ MODEL_TARGET='gcs': downloading from Cloud Storage is not implemented.\n"
            "   → Implement it here (google.cloud.storage), or set MODEL_TARGET=local in your .env."
        )

    if MODEL_TARGET == "mlflow":
        raise NotImplementedError(
            "❌ MODEL_TARGET='mlflow': loading from MLflow is not implemented.\n"
            "   → Use mlflow.<framework>.load_model with the alias, or set MODEL_TARGET=local in your .env."
        )

    return None


# ==============================================================================
# 🏷️ MLFLOW ALIASES
# ==============================================================================
def mlflow_latest_version() -> str | None:
    """Return the highest version registered under MLFLOW_MODEL_NAME."""
    if not MLFLOW_MODEL_NAME:
        return None

    mlflow.set_tracking_uri(MLFLOW_TRACKING_URI)
    client = MlflowClient()

    versions = client.search_model_versions(f"name='{MLFLOW_MODEL_NAME}'")
    if not versions:
        return None

    return max(versions, key=lambda version: int(version.version)).version


def mlflow_set_alias(version: str | int | None = None, alias: str = DEFAULT_ALIAS) -> None:
    """
    Point `alias` at a given version of the registered model.

    Aliases are the current mechanism: the Staging/Production model stages are
    deprecated since MLflow 2.x. An alias is also more flexible — a single
    version can carry several, and promoting a model leaves the other versions
    untouched.

    If `version` is None, the latest registered version is used.
    """
    if not MLFLOW_MODEL_NAME:
        raise ValueError(
            "❌ MLFLOW_MODEL_NAME is empty: cannot identify the model in the registry.\n"
            "   → Set MLFLOW_MODEL_NAME in your .env."
        )

    mlflow.set_tracking_uri(MLFLOW_TRACKING_URI)
    client = MlflowClient()

    if version is None:
        version = mlflow_latest_version()
        if version is None:
            logger.warning(f"No registered model named {MLFLOW_MODEL_NAME}")
            return None

    client.set_registered_model_alias(
        name=MLFLOW_MODEL_NAME,
        alias=alias,
        version=str(version),
    )

    logger.info(f"{MLFLOW_MODEL_NAME} version {version} is now aliased as '{alias}'")
    return None


# ==============================================================================
# 🔁 MLFLOW RUN DECORATOR
# ==============================================================================
def mlflow_run(func):
    """
    Generic function to log params and results to MLflow along with universal auto-logging.

    Args:
        - func (function): Function you want to run within the MLflow run
    """

    @functools.wraps(func)
    def wrapper(*args, **kwargs):
        # A run left open (earlier exception, interrupted notebook cell…) makes
        # start_run() fail. Close it first.
        if mlflow.active_run():
            mlflow.end_run()

        # Without an explicit URI, MLflow writes to ./mlruns (git-ignored):
        # handy for local development without a tracking server.
        if MLFLOW_TRACKING_URI:
            mlflow.set_tracking_uri(MLFLOW_TRACKING_URI)

        if MLFLOW_EXPERIMENT:
            mlflow.set_experiment(experiment_name=MLFLOW_EXPERIMENT)

        with mlflow.start_run():
            # autolog() covers TensorFlow/Keras, scikit-learn, XGBoost, PyTorch…
            # with no framework-specific code.
            mlflow.autolog()
            results = func(*args, **kwargs)

        logger.debug("mlflow_run auto-log done")

        return results

    return wrapper
