"""
Logging setup.

Loguru owns the application's log stream. Uvicorn and Prefect, which write to
the standard `logging` module, are routed into it, so a serving or orchestrating
process emits ONE stream in ONE format instead of two interleaved ones.

`setup_logging()` runs when the package is imported (see `__init__.py`).
"""

import logging
import sys

from loguru import logger

from {{ package_name }}.params import LOG_LEVEL

# Loggers that would otherwise keep their own handlers and formatting. uvicorn
# installs several, and turns propagation off on them.
{% if with_mlflow %}#
# MLflow is deliberately absent. It installs its own StreamHandler when imported,
# and that import happens after this module has run, so whatever is set here gets
# replaced. Its autolog lines therefore keep MLflow's format. Overriding that
# would mean re-running the capture after every library import — not worth it for
# library diagnostics, and fragile.
{% endif %}INTERCEPTED_LOGGERS = (
    "uvicorn",
    "uvicorn.error",
    "uvicorn.access",
{% if with_prefect %}    "prefect",
{% endif %})

_configured = False


class _InterceptHandler(logging.Handler):
    """Forward standard-library records to loguru, level and origin intact."""

    def emit(self, record: logging.LogRecord) -> None:
        try:
            level: str | int = logger.level(record.levelname).name
        except ValueError:
            level = record.levelno

        # The record already knows where it came from. Copy that over rather
        # than recompute a stack depth: the number of frames between the caller
        # and this handler changes with every library in between, and guessing
        # it wrong attributes every line to `logging:<line>`.
        def carry_origin(log_record: dict) -> None:
            log_record.update(
                name=record.name,
                function=record.funcName,
                line=record.lineno,
            )

        logger.patch(carry_origin).opt(exception=record.exc_info).log(level, record.getMessage())


def setup_logging() -> None:
    """
    Install the loguru sink and capture the standard logging module.

    Idempotent: a second call does nothing, so any entry point may call it
    without guarding.
    """
    global _configured
    if _configured:
        return
    _configured = True

    # Drop loguru's default handler: the format below replaces it, and keeping
    # both would print every message twice.
    logger.remove()

    # Two sinks on the same stream, split at WARNING so the origin
    # (`module:line`) appears only where it earns its width: below that it names
    # the module that wrote the message, above it answers "who said this",
    # which is the whole question when the message comes from a library.
    #
    # Both carry the same LOG_LEVEL, so setting it to ERROR silences warnings
    # too: the split is the format, not the threshold.
    #
    # diagnose=True, loguru's default for tracebacks, prints the VALUE of every
    # local variable. This project holds .env contents in memory — credentials,
    # tokens — so a traceback would copy them into the logs.
    shared = {
        "level": LOG_LEVEL,
        "diagnose": False,
        "backtrace": False,
    }

    logger.add(
        sys.stderr,
        filter=lambda record: record["level"].no < logging.WARNING,
        format=(
            "<green>{time:HH:mm:ss}</green>  "
            "<level>{level: <8}</level> "
            "<level>{message}</level>"
        ),
        **shared,
    )

    logger.add(
        sys.stderr,
        filter=lambda record: record["level"].no >= logging.WARNING,
        format=(
            "<green>{time:HH:mm:ss}</green>  "
            "<level>{level: <8}</level> "
            "<cyan>{name}</cyan>:<cyan>{line}</cyan>  "
            "<level>{message}</level>"
        ),
        **shared,
    )

    # Console only. To also keep a file, uncomment — `logs/` and `*.log` are
    # already git-ignored:
    #
    # logger.add(
    #     "logs/app.log",
    #     level=LOG_LEVEL,
    #     rotation="10 MB",
    #     retention="10 days",
    #     compression="zip",
    #     encoding="utf-8",
    #     diagnose=False,
    #     backtrace=False,
    # )

    # force=True drops handlers already in place, which matters because uvicorn
    # configures logging before it imports the application.
    logging.basicConfig(handlers=[_InterceptHandler()], level=0, force=True)

    for name in INTERCEPTED_LOGGERS:
        stdlib_logger = logging.getLogger(name)
        stdlib_logger.handlers = [_InterceptHandler()]
        stdlib_logger.propagate = False
